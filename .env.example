# Copy to .env.local for local dev. Production values live in Netlify's
# environment variables (Site settings → Environment variables).

# PostHog product analytics. Public project token — it ships in the client
# bundle by design. Leave unset to disable analytics entirely (the default
# locally and in deploy previews, so dev traffic never hits production data).
#
# IMPORTANT: the SDK is configured with `cookieless_mode: 'always'`, which
# requires cookieless mode to ALSO be enabled in the PostHog project settings.
# If it isn't, PostHog silently drops every event server-side.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
